# ローカル開発用環境変数（1Password 不要）
#
# DB・Auth・Google OAuth・通知など、ローカル開発に必要な値はすべてここに平文で保存します
# （.gitignore 済みのためコミットされません）。1Password は本番デプロイと本番 DB 確認にのみ使用します。
#
# セットアップ:
#   1. cp .env.local.example .env.local
#   2. 下記の値を編集
#   3. npm run db:setup    # DB_NAME / DB_USER / DB_PASSWORD でローカル MySQL にユーザー・DB を作成
#   4. npm run dev

# Database（ローカル MySQL 127.0.0.1:3306。値は自由に決めてよい）
DB_NAME=
DB_USER=
DB_PASSWORD=

# NextAuth（任意の文字列で可。生成例: openssl rand -hex 32）
AUTH_SECRET=

# Google OAuth（本番とは別の開発用クライアントを Google Cloud Console で作成）
#   承認済みリダイレクト URI: http://localhost:3000/api/auth/callback/google
#   （スマホから LAN IP で確認する場合は http://<LAN-IP>.sslip.io:3000/api/auth/callback/google も追加）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signaly ログイン通知（任意。未設定なら通知をスキップする）
SIGNALY_WEBHOOK_LOGIN_URL=
