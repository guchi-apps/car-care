# ローカル開発用環境変数（1Password 不要）
#
# DB・Supabase・通知など、ローカル開発に必要な値はすべてここに平文で保存します
# （.gitignore 済みのためコミットされません）。1Password は本番デプロイと本番 DB 確認にのみ使用します。
#
# セットアップ:
#   1. cp .env.local.example .env.local
#   2. 下記の値を編集
#   3. npm run db:setup    # DB_NAME / DB_USER / DB_PASSWORD でローカル MySQL にユーザー・DB を作成
#   4. npm run db:migrate
#   5. npm run dev

# Database（ローカル MySQL 127.0.0.1:3306。値は自由に決めてよい）
DB_NAME=
DB_USER=
DB_PASSWORD=

# Supabase Auth（**開発用**の Supabase プロジェクト。本番とは別プロジェクト）
#   1Password の Supabase 開発用アイテムにある project-url / publishable-key を貼り付ける。
#   ローカル開発で 1Password に依存しないよう、ここに直接値を書く。
#   Supabase ダッシュボードの Authentication > URL Configuration > Redirect URLs に
#   http://localhost:3000/auth/callback を登録しておくこと（ポートを変える場合はそれに合わせる）。
#   スマホから LAN 経由で確認する場合は http://<LAN-IP>.sslip.io:3000/auth/callback も追加する
#   （生 IP は Google が拒否する）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可する Google アカウント（カンマ区切り）。**未設定の場合は誰もログインできない**
ALLOWED_GOOGLE_EMAILS=

# Signaly ログイン通知（任意。未設定なら通知をスキップする）
SIGNALY_LOGIN_WEBHOOK_URL=

# Zaim連携（任意。未設定なら設定画面に「Zaim連携」を出さない）
#   https://dev.zaim.net でアプリを登録して consumer key / secret を発行する。
#   コールバックURLには http://localhost:8026/api/zaim/callback のように
#   **このアプリのオリジン + /api/zaim/callback** を登録する（ポートは環境に合わせる）。
ZAIM_CONSUMER_KEY=
ZAIM_CONSUMER_SECRET=
# 利用者ごとのアクセストークンをDBへ暗号化して保存するための鍵（16文字以上のランダム文字列）。
#   例: openssl rand -hex 32
#   **変更すると保存済みのトークンを復号できなくなり、連携し直しになる。**
ZAIM_TOKEN_ENCRYPTION_KEY=
# Zaim連携を使ってよいGoogleアカウント（カンマ区切り）。**未設定なら誰も使えない**
ZAIM_ALLOWED_EMAILS=
