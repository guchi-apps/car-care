generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "mysql"
}

// --- 認証 ---
//
// ログインは Supabase Auth（Google）が担う。users.id は車両・給油・メンテナンスの外部キーに
// 使われているため差し替えられないので、Supabase 側のユーザー ID は supabase_user_id に持つ。
// Supabase 移行前から存在するユーザーは NULL で、初回ログイン時にメールアドレスで紐付ける
// （src/app/auth/callback/route.ts）。
//
// accounts / sessions / verification_tokens / authenticators と users.email_verified は
// 旧 NextAuth（Auth.js）が使っていた列・テーブル。移行の切り戻し余地を残すため今回は残す。
model User {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique @map("supabase_user_id")
  name           String?
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  image          String?

  accounts              Account[]
  sessions              Session[]
  authenticators        Authenticator[]
  vehicles              Vehicle[]
  maintenanceCategories MaintenanceCategory[]
  gasStationBrands      GasStationBrand[]
  registeredGasStations RegisteredGasStation[]
  kakeiboSetting        KakeiboSetting?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id")
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key") @db.Text
  counter              BigInt
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

// --- Application ---

enum FuelType {
  REGULAR
  PREMIUM
  DIESEL
  KEROSENE
  ELECTRIC
  HYDROGEN
  OTHER
}

enum DriveType {
  FF
  FR
  RR
  MR
  AWD
  FOUR_WD
}

model Vehicle {
  id                    String     @id @default(cuid())
  userId                String     @map("user_id")
  name                  String
  manufacturer          String?
  modelName             String?    @map("model_name")
  modelCode             String?    @map("model_code")
  fuelType              FuelType?  @map("fuel_type")
  inspectionExpiry      DateTime?  @map("inspection_expiry") @db.Date
  licensePlate          String?    @map("license_plate")
  firstRegistrationDate DateTime?  @map("first_registration_date") @db.Date
  initialOdometer       Int?       @map("initial_odometer")
  displacement          Int?
  driveType             DriveType? @map("drive_type")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]

  @@map("vehicles")
}

model MaintenanceCategory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  displayOrder Int      @default(0) @map("display_order")
  intervalKm   Int?     @map("interval_km")
  intervalDays Int?     @map("interval_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]

  @@map("maintenance_categories")
}

model GasStationBrand {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  matchKeywords String?  @map("match_keywords") @db.Text
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, displayOrder])
  @@map("gas_station_brands")
}

model RegisteredGasStation {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  osmId            String?  @map("osm_id")
  latitude         Float?   @map("latitude")
  longitude        Float?   @map("longitude")
  registeredName   String   @map("registered_name")
  brand            String?
  hiddenFromPicker Boolean  @default(false) @map("hidden_from_picker")
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, osmId])
  @@unique([userId, registeredName])
  @@index([userId, displayOrder])
  @@map("registered_gas_stations")
}

model MaintenanceLog {
  id         String   @id @default(cuid())
  vehicleId  String   @map("vehicle_id")
  categoryId String   @map("category_id")
  date       DateTime
  odometer   Int
  cost       Int
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  vehicle  Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

model FuelLog {
  id               String   @id @default(cuid())
  vehicleId        String   @map("vehicle_id")
  date             DateTime
  distanceKm       Decimal  @map("distance_km") @db.Decimal(10, 2)
  odometer         Int?     @map("odometer")
  fuelAmount       Decimal  @map("fuel_amount") @db.Decimal(10, 2)
  pricePerLiter    Int      @map("price_per_liter")
  totalCost        Int      @map("total_cost")
  isFull           Boolean  @default(false) @map("is_full")
  gasStationName   String?  @map("gas_station_name")
  gasStationBrands String?  @map("gas_station_brands")
  gasStationOsmId  String?  @map("gas_station_osm_id")
  /// Asset Manager 側の取り込み ID（#141）。家計簿へ送ったかどうかはこれで判定する。
  assetManagerReceiptId String? @map("asset_manager_receipt_id")
  /// OAuth 時代（#26）に Zaim へ直接登録した明細の ID。新しい記録には入らない。
  zaimMoneyId      String?  @map("zaim_money_id")
  /// 家計簿へ送った日時（#141 より前は Zaim へ登録した日時）。
  zaimRegisteredAt DateTime? @map("zaim_registered_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("fuel_logs")
}

/// 家計簿（Zaim）連携の設定。**ユーザーごとに1件**持つ。
///
/// car-care は Zaim へ直接書かない。給油記録を Asset Manager へ送るかどうかと、送るときの
/// 支払元カード名だけをここに持つ（#141）。Zaim への登録は Asset Manager 側で行われる。
///
/// テーブル名が `zaim_connections` のままなのは、OAuth 時代（#26）の列を切り戻しの余地として
/// 残しているため。使っていない列（`access_token` 系・`category_*`・`genre_*`・`account_id`・
/// `zaim_user_*`）の DROP とテーブルの改名は別 Issue で行う。
model KakeiboSetting {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// 給油を記録したら自動で家計簿へ送るか。
  autoSend Boolean @default(true) @map("auto_register")
  /// 支払元の Zaim 口座名。Asset Manager へ accountHint として渡す。
  cardAccountName String? @map("account_name")
  /// 最後に家計簿へ送った日時。
  lastSentAt DateTime? @map("last_registered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ここから下は OAuth 時代の残骸で、誰も読み書きしていない（#141）。
  zaimUserId        String? @map("zaim_user_id")
  zaimUserName      String? @map("zaim_user_name")
  accessToken       String? @map("access_token") @db.Text
  accessTokenSecret String? @map("access_token_secret") @db.Text
  categoryId        String? @map("category_id")
  categoryName      String? @map("category_name")
  genreId           String? @map("genre_id")
  genreName         String? @map("genre_name")
  accountId         String? @map("account_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("zaim_connections")
}
