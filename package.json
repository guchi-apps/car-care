{
  "name": "car-care",
  "version": "1.5.1",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/with-local-env.sh sh -c 'prisma generate && node scripts/generate-sw.mjs && next build'",
    "build:ci": "prisma generate && node scripts/generate-sw.mjs && next build",
    "generate:sw": "node scripts/generate-sw.mjs",
    "start": "bash scripts/with-local-env.sh next start",
    "start:prod": "NODE_ENV=production next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "env:init": "cp -n .env.local.example .env.local && cp -n .env.op.example .env.op && echo 'Created .env.local (edit values, then: npm run db:setup && npm run dev). .env.op is only needed for db:*:prod.'",
    "env:check": "bash scripts/with-local-env.sh bash scripts/env-check.sh",
    "db:generate": "prisma generate",
    "db:check": "bash scripts/with-local-env.sh bash scripts/tsx.sh scripts/db-check.ts",
    "db:setup": "bash scripts/setup-db.sh",
    "db:migrate": "bash scripts/with-local-env.sh prisma migrate deploy",
    "db:migrate:dev": "bash scripts/with-local-env.sh prisma migrate dev",
    "db:migrate:fix-checksums": "bash scripts/with-local-env.sh bash scripts/tsx.sh scripts/fix-migration-checksums.ts",
    "db:migrate:fix": "bash scripts/with-local-env.sh prisma migrate resolve --rolled-back 20250621000000_init",
    "db:migrate:resolve": "bash scripts/with-local-env.sh prisma migrate resolve",
    "db:deploy": "bash scripts/with-local-env.sh prisma migrate deploy",
    "db:studio": "bash scripts/with-local-env.sh prisma studio",
    "db:check:prod": "bash scripts/with-op-prod-db.sh bash scripts/tsx.sh scripts/db-check.ts",
    "db:studio:prod": "bash scripts/with-op-prod-db.sh prisma studio",
    "db:tunnel:prod": "bash scripts/prod-db-tunnel.sh",
    "db:check:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh bash scripts/tsx.sh scripts/db-check.ts",
    "db:studio:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh prisma studio",
    "db:migrate:prod": "bash scripts/with-op-prod-db.sh prisma migrate deploy",
    "db:migrate:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh prisma migrate deploy",
    "db:migrate:status:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh prisma migrate status",
    "db:repair:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh bash scripts/tsx.sh scripts/repair-prod-schema-drift.ts",
    "db:diagnose:prod:tunnel": "DB_TUNNEL=true bash scripts/with-op-prod-db.sh bash scripts/tsx.sh scripts/db-prod-diagnose.ts",
    "dev:prod-db": "bash scripts/dev-prod-db.sh",
    "dev:prod-db:tunnel": "DB_TUNNEL=true bash scripts/dev-prod-db.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "mariadb": "^3.5.3",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
