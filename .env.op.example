# 1Password CLI 用環境変数ファイル
#
# セットアップ:
#   1. apps ボールトに「Car」アイテム（Secure Note 推奨）を作成
#   2. 下記と同名のフィールドを追加し、実際の値を保存
#   3. cp .env.op.example .env.op
#   4. op:// の Vault名 / アイテム名を自分の環境に合わせて編集
#   5. op signin && npm run dev
#
# 注意: このファイル名は .env.local ではなく .env.op です。
#       Next.js が op:// 文字列をそのまま読み込むのを防ぐためです。
#       DATABASE_URL は不要（DB_* から自動組み立て）。
#       開発 DB 接続先（127.0.0.1:3306）はコード固定。1Password 不要。
#       GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET はここには置かない。
#       開発用 Google OAuth クライアント（本番とは別物）は .env.local で管理する。
#       cp .env.local.example .env.local して値を設定してください。

# Vault: apps / Item: Car

# Database
# 開発: 127.0.0.1:3306 固定 / 本番: DB_HOST + DB_PORT
DB_USER=op://apps/Car/DB_USER
DB_PASSWORD=op://apps/Car/DB_PASSWORD
DB_NAME=op://apps/Car/DB_NAME
DB_HOST=op://apps/Car/DB_HOST
DB_PORT=op://apps/Car/DB_PORT

# Auth URL（開発: AUTH_URL_DEV、本番: AUTH_URL）
AUTH_URL=op://apps/Car/AUTH_URL
AUTH_URL_DEV=op://apps/Car/AUTH_URL_DEV
AUTH_SECRET=op://apps/Car/AUTH_SECRET
SIGNALY_WEBHOOK_LOGIN_URL=op://apps/Car/login_webhook_url

# 本番 DB 確認（開発環境から SSH トンネル経由で接続する場合）
# VPS の MySQL が localhost のみ待受のときに使用。直結できる場合は不要。
SSH_HOST=op://apps/Car/SSH_HOST
SSH_USER=op://apps/Car/SSH_USER
SSH_PORT=op://apps/Car/SSH_PORT
# GitHub Actions デプロイと同じ鍵（VPS の authorized_keys に登録済みのもの）
SSH_PRIVATE_KEY=op://apps/githubaction-sshkey/private_key?ssh-format=openssh
